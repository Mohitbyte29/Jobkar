name=\"insights section wrapper\">\n                <div class=\"mx-auto mb-14 max-w-[670px] text-center\" data-kid=\"1-2-5-1-1\" data-name=\"insights header\">\n                    <p class=\"mb-3 text-[11px] font-extrabold uppercase tracking-[0.18em] text-[#7a5cff]\" data-kid=\"1-2-5-1-1-1\" data-name=\"insights eyebrow label\">\n                        Trusted perspective\n                    </p>\n                    <h2 class=\"text-3xl font-extrabold tracking-[-0.045em] text-[#19182f]\" data-kid=\"1-2-5-1-1-2\" data-name=\"insights headline\">\n                        Expert Career Insights\n                    </h2>\n                    <p class=\"mt-3 text-[15px] leading-7 font-medium text-[#625f78]\" data-kid=\"1-2-5-1-1-3\" data-name=\"insights description\">\n                        Trusted by industry leaders and career coaches as the premier platform for professional growth and top-tier talent acquisition.\n                    </p>\n                </div>\n                <div class=\"grid gap-4 md:grid-cols-3\" data-kid=\"1-2-5-1-2\" data-name=\"testimonials grid\">\n                    <article class=\"rounded-[20px] border border-[#dfe0ee] bg-[#f8f8fd] p-7 shadow-[0_7px_20px_rgba(35,32,75,0.035)]\" data-kid=\"1-2-5-1-2-1\" data-name=\"sarah jenkins testimonial\">\n                        <div class=\"flex items-center gap-3.5\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"testimonial profile info\">\n                            <img alt=\"Sarah Jenkins, HR Director at TechFlow\" class=\"h-12 w-12 rounded-full object-cover ring-4 ring-[#eeecff]\" data-kid=\"1-2-5-1-2-1-1-1\" data-name=\"sarah avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?img=47\"/>\n                            <div data-kid=\"1-2-5-1-2-1-1-2\" data-name=\"profile text\">\n                                <h3 class=\"text-sm font-extrabold text-[#19182f]\" data-kid=\"1-2-5-1-2-1-1-2-1\" data-name=\"name\">\n                                    Sarah Jenkins\n                                </h3>\n                                <p class=\"mt-1 text-[11px] font-bold uppercase tracking-[0.08em] text-[#77758f]\" data-kid=\"1-2-5-1-2-1-1-2-2\" data-name=\"title\">\n                                    HR Director at TechFlow\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mt-6 flex gap-1 text-[#7a5cff]\" data-kid=\"1-2-5-1-2-1-2\" data-name=\"star ratings container\">\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-1-2-1\" data-name=\"star\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-1-2-2\" data-name=\"star\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-1-2-3\" data-name=\"star\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-1-2-4\" data-name=\"star\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-1-2-5\" data-name=\"star\">\n                                star\n                            </span>\n                        </div>\n                        <p class=\"mt-4 text-sm font-medium leading-7 text-[#625f78]\" data-kid=\"1-2-5-1-2-1-3\" data-name=\"testimonial text\">\n                            “JobKar has revolutionized how we source senior design talent. The quality of applicants is consistently higher than any other platform we've used.”\n                        </p>\n                    </article>\n                    <article class=\"rounded-[20px] border border-[#dfe0ee] bg-[#f8f8fd] p-7 shadow-[0_7px_20px_rgba(35,32,75,0.035)]\" data-kid=\"1-2-5-1-2-2\" data-name=\"david chen testimonial\">\n                        <div class=\"flex items-center gap-3.5\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"testimonial profile info\">\n                            <img alt=\"David Chen, Executive Career Coach\" class=\"h-12 w-12 rounded-full object-cover ring-4 ring-[#eeecff]\" data-kid=\"1-2-5-1-2-2-1-1\" data-name=\"david avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?img=12\"/>\n                            <div data-kid=\"1-2-5-1-2-2-1-2\" data-name=\"profile text\">\n                                <h3 class=\"text-sm font-extrabold text-[#19182f]\" data-kid=\"1-2-5-1-2-2-1-2-1\" data-name=\"name\">\n                                    David Chen\n                                </h3>\n                                <p class=\"mt-1 text-[11px] font-bold uppercase tracking-[0.08em] text-[#77758f]\" data-kid=\"1-2-5-1-2-2-1-2-2\" data-name=\"title\">\n                                    Executive Career Coach\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mt-6 flex gap-1 text-[#7a5cff]\" data-kid=\"1-2-5-1-2-2-2\" data-name=\"star ratings container\">\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-2-2-1\" data-name=\"star\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-2-2-2\" data-name=\"star\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-2-2-3\" data-name=\"star\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-2-2-4\" data-name=\"star\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-2-2-5\" data-name=\"star\">\n                                star\n                            </span>\n                        </div>\n                        <p class=\"mt-4 text-sm font-medium leading-7 text-[#625f78]\" data-kid=\"1-2-5-1-2-2-3\" data-name=\"testimonial text\">\n                            “I always recommend JobKar to my clients. It's the only site where the user experience for the candidate matches the high-end nature of the roles being offered.”\n                        </p>\n                    </article>\n                    <article class=\"rounded-[20px] border border-[#dfe0ee] bg-[#f8f8fd] p-7 shadow-[0_7px_20px_rgba(35,32,75,0.035)]\" data-kid=\"1-2-5-1-2-3\" data-name=\"marcus rodriguez testimonial\">\n                        <div class=\"flex items-center gap-3.5\" data-kid=\"1-2-5-1-2-3-1\" data-name=\"testimonial profile info\">\n                            <img alt=\"Marcus Rodriguez, Talent Lead at InnovateX\" class=\"h-12 w-12 rounded-full object-cover ring-4 ring-[#eeecff]\" data-kid=\"1-2-5-1-2-3-1-1\" data-name=\"marcus avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?img=32\"/>\n                            <div data-kid=\"1-2-5-1-2-3-1-2\" data-name=\"profile text\">\n                                <h3 class=\"text-sm font-extrabold text-[#19182f]\" data-kid=\"1-2-5-1-2-3-1-2-1\" data-name=\"name\">\n                                    Marcus Rodriguez\n                                </h3>\n                                <p class=\"mt-1 text-[11px] font-bold uppercase tracking-[0.08em] text-[#77758f]\" data-kid=\"1-2-5-1-2-3-1-2-2\" data-name=\"title\">\n                                    Talent Lead at InnovateX\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mt-6 flex gap-1 text-[#7a5cff]\" data-kid=\"1-2-5-1-2-3-2\" data-name=\"star ratings container\">\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-3-2-1\" data-name=\"star\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-3-2-2\" data-name=\"star\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-3-2-3\" data-name=\"star\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-3-2-4\" data-name=\"star\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-2-5-1-2-3-2-5\" data-name=\"star half\">\n                                star_half\n                            </span>\n                        </div>\n                        <p class=\"mt-4 text-sm font-medium leading-7 text-[#625f78]\" data-kid=\"1-2-5-1-2-3-3\" data-name=\"testimonial text\">\n                            “The matching algorithm is incredibly accurate. We find that the Latest Opportunities section consistently surfaces the exact profiles we are looking for.”\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#dfe0ee] bg-[#f8f8fd] px-6 py-14 lg:px-8\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto grid max-w-[1120px] gap-10 sm:grid-cols-2 lg:grid-cols-4\" data-kid=\"1-3-1\" data-name=\"footer grid container\">\n            <div data-kid=\"1-3-1-1\" data-name=\"brand and contact column\">\n                <div class=\"flex items-center gap-3 text-lg font-extrabold tracking-[-0.04em] text-[#19182f]\" data-kid=\"1-3-1-1-1\" data-name=\"footer brand link\">\n                    <span class=\"flex h-8 w-8 items-center justify-center rounded-[10px] bg-[#7a5cff] text-sm font-extrabold text-white\" data-kid=\"1-3-1-1-1-1\" data-name=\"footer logo icon\">\n                        J\n                    </span>\n                    JobKar\n                </div>\n                <p class=\"mt-4 max-w-[250px] text-sm font-medium leading-6 text-[#77758f]\" data-kid=\"1-3-1-1-2\" data-name=\"footer description text\">\n                    Elevating the standard of hiring since 2026. Your gateway to elite professional opportunities.\n                </p>\n                <div class=\"mt-5 flex gap-3 text-[#77758f]\" data-kid=\"1-3-1-1-3\" data-name=\"social links container\">\n                    <span class=\"material-symbols-outlined\" data-kid=\"1-3-1-1-3-1\" data-name=\"language icon\">\n                        language\n                    </span>\n                    <span class=\"material-symbols-outlined\" data-kid=\"1-3-1-1-3-2\" data-name=\"share icon\">\n                        share\n                    </span>\n                </div>\n            </div>\n            <div data-kid=\"1-3-1-2\" data-name=\"candidates footer links\">\n                <h3 class=\"text-sm font-extrabold text-[#19182f]\" data-kid=\"1-3-1-2-1\" data-name=\"candidates heading\">\n                    Candidates\n                </h3>\n                <ul class=\"mt-4 space-y-3 text-sm font-medium text-[#77758f]\" data-kid=\"1-3-1-2-2\" data-name=\"candidates list\">\n                    <li data-kid=\"1-3-1-2-2-1\" data-name=\"browse jobs link\">\n                        Browse Jobs\n                    </li>\n                    <li data-kid=\"1-3-1-2-2-2\" data-name=\"career advice link\">\n                        Career Advice\n                    </li>\n                    <li data-kid=\"1-3-1-2-2-3\" data-name=\"job alerts link\">\n                        Job Alerts\n                    </li>\n                    <li data-kid=\"1-3-1-2-2-4\" data-name=\"help center link\">\n                        Help Center\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"1-3-1-3\" data-name=\"employers footer links\">\n                <h3 class=\"text-sm font-extrabold text-[#19182f]\" data-kid=\"1-3-1-3-1\" data-name=\"employers heading\">\n                    Employers\n                </h3>\n                <ul class=\"mt-4 space-y-3 text-sm font-medium text-[#77758f]\" data-kid=\"1-3-1-3-2\" data-name=\"employers list\">\n                    <li data-kid=\"1-3-1-3-2-1\" data-name=\"post a job link\">\n                        Post a Job\n                    </li>\n                    <li data-kid=\"1-3-1-3-2-2\" data-name=\"talent solutions link\">\n                        Talent Solutions\n                    </li>\n                    <li data-kid=\"1-3-1-3-2-3\" data-name=\"pricing link\">\n                        Pricing\n                    </li>\n                    <li data-kid=\"1-3-1-3-2-4\" data-name=\"resources link\">\n                        Resources\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"1-3-1-4\" data-name=\"legal footer links\">\n                <h3 class=\"text-sm font-extrabold text-[#19182f]\" data-kid=\"1-3-1-4-1\" data-name=\"legal heading\">\n                    Legal\n                </h3>\n                <ul class=\"mt-4 space-y-3 text-sm font-medium text-[#77758f]\" data-kid=\"1-3-1-4-2\" data-name=\"legal list\">\n                    <li data-kid=\"1-3-1-4-2-1\" data-name=\"privacy policy link\">\n                        Privacy Policy\n                    </li>\n                    <li data-kid=\"1-3-1-4-2-2\" data-name=\"terms of service link\">\n                        Terms of Service\n                    </li>\n                    <li data-kid=\"1-3-1-4-2-3\" data-name=\"cookie policy link\">\n                        Cookie Policy\n                    </li>\n                    <li data-kid=\"1-3-1-4-2-4\" data-name=\"contact link\">\n                        Contact\n                    </li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"mx-auto mt-12 max-w-[1120px] border-t border-[#dfe0ee] pt-6 text-center text-xs font-semibold text-[#8a88a0]\" data-kid=\"1-3-2\" data-name=\"footer copyright text\">\n            © 2026 JobKar Inc. All rights reserved.\n        </div>\n    </footer>\n</div>\n",
