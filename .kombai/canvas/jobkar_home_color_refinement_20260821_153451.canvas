e class=\"rounded-[16px] border-t-2 border-[#6857E8] bg-[#FBFCFF] p-7 shadow-[0_8px_24px_rgba(17,21,47,0.04)]\" data-kid=\"1-2-5-1-2-1\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-2-5-1-2-1-1\">\n                            <div class=\"flex h-12 w-12 items-center justify-center rounded-full bg-[#E6E9FF] text-[15px] font-extrabold text-[#6857E8]\" data-kid=\"1-2-5-1-2-1-1-1\">\n                                SJ\n                            </div>\n                            <div data-kid=\"1-2-5-1-2-1-1-2\">\n                                <h3 class=\"text-[14px] font-extrabold text-[#171A2F]\" data-kid=\"1-2-5-1-2-1-1-2-1\">\n                                    Sarah Jenkins\n                                </h3>\n                                <p class=\"mt-1 text-[11px] font-bold uppercase tracking-[0.08em] text-[#7B84A0]\" data-kid=\"1-2-5-1-2-1-1-2-2\">\n                                    HR Director at TechFlow\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mt-6 flex gap-1 text-[#765CFF]\" data-kid=\"1-2-5-1-2-1-2\">\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-1-2-1\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-1-2-2\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-1-2-3\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-1-2-4\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-1-2-5\">\n                                star\n                            </span>\n                        </div>\n                        <p class=\"mt-4 text-[14px] font-medium italic leading-7 text-[#59627A]\" data-kid=\"1-2-5-1-2-1-3\">\n                            “JobKar has revolutionized how we source senior design talent. The quality of applicants is consistently higher than any other platform we've used.”\n                        </p>\n                    </article>\n                    <article class=\"rounded-[16px] border-t-2 border-[#6857E8] bg-[#FBFCFF] p-7 shadow-[0_8px_24px_rgba(17,21,47,0.04)]\" data-kid=\"1-2-5-1-2-2\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-2-5-1-2-2-1\">\n                            <div class=\"flex h-12 w-12 items-center justify-center rounded-full bg-[#E6E9FF] text-[15px] font-extrabold text-[#6857E8]\" data-kid=\"1-2-5-1-2-2-1-1\">\n                                DC\n                            </div>\n                            <div data-kid=\"1-2-5-1-2-2-1-2\">\n                                <h3 class=\"text-[14px] font-extrabold text-[#171A2F]\" data-kid=\"1-2-5-1-2-2-1-2-1\">\n                                    David Chen\n                                </h3>\n                                <p class=\"mt-1 text-[11px] font-bold uppercase tracking-[0.08em] text-[#7B84A0]\" data-kid=\"1-2-5-1-2-2-1-2-2\">\n                                    Executive Career Coach\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mt-6 flex gap-1 text-[#765CFF]\" data-kid=\"1-2-5-1-2-2-2\">\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-2-2-1\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-2-2-2\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-2-2-3\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-2-2-4\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-2-2-5\">\n                                star\n                            </span>\n                        </div>\n                        <p class=\"mt-4 text-[14px] font-medium italic leading-7 text-[#59627A]\" data-kid=\"1-2-5-1-2-2-3\">\n                            “I always recommend JobKar to my clients. It's the only site where the user experience for the candidate matches the high-end nature of the roles being offered.”\n                        </p>\n                    </article>\n                    <article class=\"rounded-[16px] border-t-2 border-[#6857E8] bg-[#FBFCFF] p-7 shadow-[0_8px_24px_rgba(17,21,47,0.04)]\" data-kid=\"1-2-5-1-2-3\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-2-5-1-2-3-1\">\n                            <div class=\"flex h-12 w-12 items-center justify-center rounded-full bg-[#E6E9FF] text-[15px] font-extrabold text-[#6857E8]\" data-kid=\"1-2-5-1-2-3-1-1\">\n                                MR\n                            </div>\n                            <div data-kid=\"1-2-5-1-2-3-1-2\">\n                                <h3 class=\"text-[14px] font-extrabold text-[#171A2F]\" data-kid=\"1-2-5-1-2-3-1-2-1\">\n                                    Marcus Rodriguez\n                                </h3>\n                                <p class=\"mt-1 text-[11px] font-bold uppercase tracking-[0.08em] text-[#7B84A0]\" data-kid=\"1-2-5-1-2-3-1-2-2\">\n                                    Talent Lead at InnovateX\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mt-6 flex gap-1 text-[#765CFF]\" data-kid=\"1-2-5-1-2-3-2\">\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-3-2-1\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-3-2-2\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-3-2-3\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-3-2-4\">\n                                star\n                            </span>\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-5-1-2-3-2-5\">\n                                star_half\n                            </span>\n                        </div>\n                        <p class=\"mt-4 text-[14px] font-medium italic leading-7 text-[#59627A]\" data-kid=\"1-2-5-1-2-3-3\">\n                            “The matching algorithm is incredibly accurate. We find that the Latest Opportunities section consistently surfaces the exact profiles we are looking for.”\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <footer class=\"border-t border-[#DCE2F0] bg-[#F7F8FC] px-6 py-14 lg:px-10\" data-kid=\"1-2-6\">\n            <div class=\"mx-auto grid max-w-[1280px] gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]\" data-kid=\"1-2-6-1\">\n                <div data-kid=\"1-2-6-1-1\">\n                    <div class=\"flex items-center gap-2 text-[19px] font-extrabold tracking-[-0.06em] text-[#171A2F]\" data-kid=\"1-2-6-1-1-1\">\n                        <span class=\"flex h-7 w-7 items-center justify-center rounded-[8px] bg-[#6857E8] text-[12px] text-white\" data-kid=\"1-2-6-1-1-1-1\">\n                            J\n                        </span>\n                        JobKar\n                    </div>\n                    <p class=\"mt-4 max-w-[250px] text-[13px] font-medium leading-6 text-[#7B84A0]\" data-kid=\"1-2-6-1-1-2\">\n                        Elevating the standard of hiring since 2026. Your gateway to elite professional opportunities.\n                    </p>\n                    <div class=\"mt-5 flex gap-3 text-[#7B84A0]\" data-kid=\"1-2-6-1-1-3\">\n                        <span class=\"material-symbols-outlined text-[19px]\" data-kid=\"1-2-6-1-1-3-1\">\n                            language\n                        </span>\n                        <span class=\"material-symbols-outlined text-[19px]\" data-kid=\"1-2-6-1-1-3-2\">\n                            share\n                        </span>\n                    </div>\n                </div>\n                <div data-kid=\"1-2-6-1-2\">\n                    <h4 class=\"text-[13px] font-extrabold text-[#171A2F]\" data-kid=\"1-2-6-1-2-1\">\n                        Candidates\n                    </h4>\n                    <ul class=\"mt-4 space-y-3 text-[13px] font-semibold text-[#7B84A0]\" data-kid=\"1-2-6-1-2-2\">\n                        <li data-kid=\"1-2-6-1-2-2-1\">\n                            <a class=\"transition-colors hover:text-[#6857E8]\" data-kid=\"1-2-6-1-2-2-1-1\" href=\"#jobs\">\n                                Browse Jobs\n                            </a>\n                        </li>\n                        <li data-kid=\"1-2-6-1-2-2-2\">\n                            Career Advice\n                        </li>\n                        <li data-kid=\"1-2-6-1-2-2-3\">\n                            Job Alerts\n                        </li>\n                        <li data-kid=\"1-2-6-1-2-2-4\">\n                            Help Center\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-2-6-1-3\">\n                    <h4 class=\"text-[13px] font-extrabold text-[#171A2F]\" data-kid=\"1-2-6-1-3-1\">\n                        Employers\n                    </h4>\n                    <ul class=\"mt-4 space-y-3 text-[13px] font-semibold text-[#7B84A0]\" data-kid=\"1-2-6-1-3-2\">\n                        <li data-kid=\"1-2-6-1-3-2-1\">\n                            Post a Job\n                        </li>\n                        <li data-kid=\"1-2-6-1-3-2-2\">\n                            Talent Solutions\n                        </li>\n                        <li data-kid=\"1-2-6-1-3-2-3\">\n                            Pricing\n                        </li>\n                        <li data-kid=\"1-2-6-1-3-2-4\">\n                            Resources\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-2-6-1-4\">\n                    <h4 class=\"text-[13px] font-extrabold text-[#171A2F]\" data-kid=\"1-2-6-1-4-1\">\n                        Legal\n                    </h4>\n                    <ul class=\"mt-4 space-y-3 text-[13px] font-semibold text-[#7B84A0]\" data-kid=\"1-2-6-1-4-2\">\n                        <li data-kid=\"1-2-6-1-4-2-1\">\n                            Privacy Policy\n                        </li>\n                        <li data-kid=\"1-2-6-1-4-2-2\">\n                            Terms of Service\n                        </li>\n                        <li data-kid=\"1-2-6-1-4-2-3\">\n                            Cookie Policy\n                        </li>\n                        <li data-kid=\"1-2-6-1-4-2-4\">\n                            Contact\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"mx-auto mt-12 max-w-[1280px] border-t border-[#DCE2F0] pt-5 text-center text-[12px] font-semibold text-[#8A93A9]\" data-kid=\"1-2-6-2\">\n                © 2026 JobKar Inc. All rights reserved.\n            </div>\n        </footer>\n    </main>\n</div>\n",
