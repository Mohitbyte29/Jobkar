      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0');\n  .material-symbols-outlined { font-family: 'Material Symbols Outlined'; font-weight: 400; font-style: normal; font-size: 20px; line-height: 1; letter-spacing: normal; text-transform: none; display: inline-block; white-space: nowrap; word-wrap: normal; direction: ltr; -webkit-font-feature-settings: 'liga'; -webkit-font-smoothing: antialiased; font-feature-settings: 'liga'; }\n  .violet-page { background: #f8f8fd; color: #19182f; font-family: 'Manrope', sans-serif; }\n</style>\n<div class=\"violet-page min-h-screen overflow-x-hidden\" data-kid=\"1\" data-name=\"violet background page container\">\n    <nav class=\"fixed inset-x-0 top-0 z-50 border-b border-white/15 bg-[#151633]/90 text-white backdrop-blur-xl\" data-kid=\"1-1\" data-name=\"navigation bar\">\n        <div class=\"mx-auto flex h-[72px] max-w-[1240px] items-center justify-between px-6 lg:px-8\" data-kid=\"1-1-1\" data-name=\"navigation content wrapper\">\n            <a class=\"flex items-center gap-3 text-lg font-extrabold tracking-[-0.04em] text-white\" data-kid=\"1-1-1-1\" data-name=\"brand link\" href=\"#top\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-[10px] bg-[#7a5cff] text-sm font-extrabold text-white shadow-[0_0_0_5px_rgba(122,92,255,0.14)]\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon\">\n                    J\n                </span>\n                JobKar\n            </a>\n            <div class=\"hidden items-center gap-8 text-[13px] font-semibold text-white/70 lg:flex\" data-kid=\"1-1-1-2\" data-name=\"navigation menu links\">\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-1\" data-name=\"find jobs link\" href=\"#jobs\">\n                    Find Jobs\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-2\" data-name=\"find internships link\" href=\"#categories\">\n                    Find Internships\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-3\" data-name=\"companies link\" href=\"#jobs\">\n                    Companies\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-4\" data-name=\"resources link\" href=\"#insights\">\n                    Resources\n                </a>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-3\" data-name=\"header actions\">\n                <button class=\"hidden rounded-xl border border-white/20 px-4 py-2 text-[13px] font-bold text-white/80 hover:border-white/40 hover:text-white sm:inline-flex\" data-kid=\"1-1-1-3-1\" data-name=\"sign in button\">\n                    Sign In\n                </button>\n                <a class=\"inline-flex items-center rounded-xl bg-[#7a5cff] px-4 py-2.5 text-[13px] font-bold text-white shadow-[0_10px_28px_rgba(122,92,255,0.3)] hover:bg-[#8b73ff]\" data-kid=\"1-1-1-3-2\" data-name=\"post a job call to action\" href=\"#employers\">\n                    Post a Job\n                </a>\n            </div>\n        </div>\n    </nav>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <header class=\"relative isolate flex min-h-[720px] items-center overflow-hidden bg-[#151633] pt-[72px]\" data-kid=\"1-2-1\" data-name=\"hero header section\">\n            <video autoplay=\"\" class=\"absolute inset-0 h-full w-full object-cover opacity-45\" data-dynamic=\"true\" data-kid=\"1-2-1-1\" data-name=\"background hero video\" data-reason=\"video playback managed by browser\" loop=\"\" muted=\"\" playsinline=\"\" preload=\"metadata\" src=\"/api/local/images/client/src/assets/videos/video.mp4\">\n            </video>\n            <div class=\"absolute inset-0 bg-[radial-gradient(circle_at_76%_32%,rgba(122,92,255,0.34),transparent_31%),linear-gradient(108deg,#151633_